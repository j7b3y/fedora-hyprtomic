{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
      "bash": {
        "*": "ask",
        "git status": "allow",
        "git diff": "allow",
        "git log": "allow",
        "npm run": "allow", 
        "rm *": "deny",
        "sudo *": "deny",
        "grep *": "allow"
    },
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "lsp": "allow",
    "skill": "ask",
    "external_directory": "ask", 
    "doom_loop": "ask" 
    },
    "watcher": {
      "ignore": [
        "node_modules/**",
        ".git/**",
        "vendor/**",
        "dist/**",
        "build/**",
        "*.log",
        ".opencode/**",
        "__pycache__/**",
        ".next/**",
        "coverage/**"
      ]
  }
}