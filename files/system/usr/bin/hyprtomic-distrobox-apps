#!/usr/bin/env bash
# Register the .desktop files of the other distrobox containers with the host's
# application dirs, so the quickshell launcher inside the GUI container can
# list and launch them. Runs on the host:
#
#   - hyprtomic-distrobox-apps.service (systemd user unit) keeps it alive in
#     --watch mode: containers that start after login are registered on the
#     next poll, exports of removed containers are pruned;
#   - hyprtomic-gui-shell runs a one-shot pass at session start (cheap
#     fallback); `ujust refresh-distrobox-apps` triggers one manually.
#
# The GUI container only has distrobox-export/distrobox-host-exec (distrobox
# injects those), not the `distrobox` CLI, so distrobox-export is told to prefix
# the exported Exec lines with `distrobox-host-exec distrobox-enter` — the one
# form the container *can* run (the host executes the real distrobox-enter).
#
# The GUI container itself is skipped: the shell runs inside it and scans its
# own /usr/share/applications directly.
set -uo pipefail

CONTAINER="${HYPRTOMIC_GUI_CONTAINER:-hyprtomic-gui}"
APPS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
MARKER="X-HyprTomic-Container="
# --watch: seconds between polls of the running-container list. `distrobox
# list` is a cheap podman query, and the launcher picks new entries up live.
WATCH_INTERVAL="${HYPRTOMIC_DISTROBOX_APPS_INTERVAL:-15}"

log() { printf '%s\n' "$*"; }

# Container names, one per line (empty when distrobox/podman is unavailable).
# `distrobox list` separates columns with `|`, so split on that and trim.
container_names() {
    distrobox list --no-color 2>/dev/null | awk -F'|' '
        NR > 1 {
            name = $2
            gsub(/^[ \t]+|[ \t]+$/, "", name)
            if (name != "") print name
        }'
}

# Running containers only: entering a stopped container would start it, and
# session start must not boot every distrobox. Exports of stopped containers
# stay registered (launching them starts the container on demand).
running_container_names() {
    distrobox list --no-color 2>/dev/null | awk -F'|' '
        NR > 1 {
            name = $2
            status = $3
            gsub(/^[ \t]+|[ \t]+$/, "", name)
            gsub(/^[ \t]+|[ \t]+$/, "", status)
            if (name != "" && status ~ /^Up/) print name
        }'
}

# Export every visible .desktop file of one container (runs inside it).
# stdin is /dev/null on purpose: `distrobox enter` must not consume whatever
# feeds the caller (in sync() it used to eat the loop's container list, so only
# the first container was ever registered).
export_container() {
    local name="$1"
    timeout 120 distrobox enter "$name" -- \
        env DISTROBOX_ENTER_PATH="distrobox-host-exec distrobox-enter" \
        sh -lc '
            for dir in "$HOME/.local/share/applications" /usr/local/share/applications /usr/share/applications; do
                [ -d "$dir" ] || continue
                for f in "$dir"/*.desktop; do
                    [ -f "$f" ] || continue
                    grep -q "^NoDisplay=true" "$f" && continue
                    grep -q "^Hidden=true" "$f" && continue
                    # Never wrap an existing distrobox export/terminal entry.
                    grep -q "^Exec=.*distrobox" "$f" && continue
                    distrobox-export --app "$f" >/dev/null 2>&1 || true
                done
            done
        ' </dev/null 2>/dev/null
}

# Tag the files distrobox-export wrote for this container, so stale exports can
# be told apart from unrelated .desktop files.
mark_exports() {
    local name="$1" f
    for f in "$APPS_DIR/${name}-"*.desktop; do
        [ -f "$f" ] || continue
        grep -q "^${MARKER}" "$f" && continue
        sed -i "/^\[Desktop Entry\]$/a ${MARKER}${name}" "$f"
    done
}

# Remove exports whose container no longer exists. Only marked files are
# touched, and only when distrobox actually reported a container list.
prune_stale() {
    local known="$1" f c
    for f in "$APPS_DIR"/*.desktop; do
        [ -f "$f" ] || continue
        c="$(sed -n "s/^${MARKER}//p" "$f" | head -n 1)"
        [ -n "$c" ] || continue
        case " ${known} " in
            *" ${c} "*) ;;
            *) rm -f "$f"; log "removed stale export: $(basename "$f")" ;;
        esac
    done
}

# One registration pass over the running containers. Returns non-zero when it
# skipped (no distrobox / no container list), so --watch retries.
sync() {
    command -v distrobox >/dev/null 2>&1 || { log "distrobox not found; skipping"; return 1; }

    local all running
    all="$(container_names)"
    # No container list means podman/distrobox is not answering; do not touch
    # anything (pruning would delete every export).
    [ -n "$all" ] || { log "no containers reported; skipping"; return 1; }

    mkdir -p "$APPS_DIR"

    running="$(running_container_names)"
    local c
    while IFS= read -r c; do
        [ -n "$c" ] || continue
        [ "$c" = "$CONTAINER" ] && continue
        log "registering apps from '$c' ..."
        export_container "$c" || true
        mark_exports "$c" || true
    done <<< "$running"

    # Prune against every container, not just the running ones: a stopped
    # container keeps its registered apps.
    prune_stale "$(printf '%s ' $all)"
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
    fi
    log "done"
}

# --watch: stay alive for the whole session and re-sync whenever the set of
# running containers changes. Stopped containers keep their entries; starting
# one is enough to get its apps registered.
watch() {
    # Only one watcher: one started by hand (or a stale one from a previous
    # login) must not stack.
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprtomic"
    mkdir -p "$state_dir"
    exec 9>"$state_dir/distrobox-apps-watch.lock"
    flock -n 9 || { log "another watcher is already running; exiting"; return 0; }

    local last="" cur
    while :; do
        cur="$(running_container_names)"
        # Re-sync on every change; last is only advanced on success, so a
        # skipped sync (podman not answering yet) is retried.
        if [ "$cur" != "$last" ] && sync; then
            last="$cur"
        fi
        sleep "$WATCH_INTERVAL"
    done
}

main() {
    case "${1:-}" in
        --watch) watch ;;
        "") sync ;;
        *) log "usage: hyprtomic-distrobox-apps [--watch]"; return 2 ;;
    esac
}

main "$@"
