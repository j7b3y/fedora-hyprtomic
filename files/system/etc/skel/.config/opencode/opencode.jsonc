{
  "$schema": "https://opencode.ai/config.json",
  // 構造的権限ブロック - AGENTS.md の soft instruction を hard block で補完
  "permission": {
    "bash": {
      "*": "allow",
      "*sudo*": "deny",
      "yay -S *": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny"
    }
  },
  "disabled_providers": [],
  "provider": {
    "openwebui": {
      "name": "openwebui",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ai.n4ne.com/api"
      },
      "models": {
        "selfhost": {
          "name": "selfhost"
        }
      }
    }
  }
}
