#!/usr/bin/env bash
# GUI session entrypoint, run inside the GUI container by the host's
# hyprtomic-gui-shell. Starts the container-side helpers that need the Wayland
# session and then launches the shell.
#
# The quickshell config name is taken from HYPRTOMIC_QS_CONFIG (default: ii), so
# a different dotfile set only has to ship ~/.config/quickshell/<name> and set
# that variable (hyprtomic-gui-shell passes it through from the host env).
set -uo pipefail

QS_CONFIG="${HYPRTOMIC_QS_CONFIG:-ii}"

# IME: fcitx5 runs in the container; host GTK/Qt apps reach it through the
# shared session bus and the IME env vars exported by the Hyprland session.
fcitx5 -d >/dev/null 2>&1 &

# Clipboard history daemon (clipse; Super+V opens clipse-gui).
command -v clipse >/dev/null 2>&1 && clipse -listen >/dev/null 2>&1 &

# Clipboard history (cliphist + wl-clipboard live in the container) and notify
# the shell's clipboard service. The IPC call is a no-op for configs that do not
# expose a cliphistService.
wl-paste --type text  --watch bash -c "cliphist store && qs -c '$QS_CONFIG' ipc call cliphistService update" &
wl-paste --type image --watch bash -c "cliphist store && qs -c '$QS_CONFIG' ipc call cliphistService update" &

# XDG autostart for the container: the host's dex-autostart only runs entries
# whose command exists on the host (flatpaks, host tools); this pass runs the
# container's own entries and the user entries whose command lives only here.
# Backgrounded so probing the host can never delay the shell; fcitx5 is
# excluded inside (it is started manually above). Output goes to
# gui-session.log like the rest of this session.
hyprtomic-container-autostart &

exec qs -c "$QS_CONFIG"
