#!/usr/bin/env sh

powered="$(bluetoothctl show 2>/dev/null | awk -F': ' '/Powered:/ {print $2; exit}')"

if [ "$powered" != "yes" ]; then
  printf '{"text":"󰂲","class":"disabled"}\n'
  exit 0
fi

connected_count="$(bluetoothctl devices Connected 2>/dev/null | awk '/^Device / { count++ } END { print count + 0 }')"

if [ "$connected_count" -gt 0 ]; then
  printf '{"text":"󰂱 %s","class":"connected"}\n' "$connected_count"
else
  printf '{"text":"󰂯","class":"enabled"}\n'
fi
